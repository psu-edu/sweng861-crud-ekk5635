              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"error body has the one shape\", function () {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b).to.have.property(\"error\");",
                  "    pm.expect(b).to.have.property(\"message\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "admin route as an ordinary analyst",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/coverages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "coverages"
              ]
            },
            "description": "403 and not 404. The 404 elsewhere hides whether a row exists, because an id that answers differently can be enumerated. This route hides nothing - one fixed path, the same for everyone, published in the OpenAPI document."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"error body has the one shape\", function () {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b).to.have.property(\"error\");",
                  "    pm.expect(b).to.have.property(\"message\");",
                  "});",
                  "pm.test(\"403, not the 404 another tenant's row would give\", function () {",
                  "    pm.expect(pm.response.code).to.eql(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "admin route as the administrator",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/coverages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "coverages"
              ]
            },
            "description": "The one query in the service with no owner_id term, and the one response that publishes the column."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"returns rows owned by more than one analyst\", function () {",
                  "    const owners = new Set(pm.response.json().map(r => r.owner_id));",
                  "    pm.expect(owners.size).to.be.above(1);",
                  "});",
                  "pm.test(\"says who owns each row\", function () {",
                  "    pm.expect(pm.response.json().every(r => \"owner_id\" in r)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "the administrator's own list is still their own",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/coverages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coverages"
              ]
            },
            "description": "Seeing every row is a separate route, not a mode the tenant list slips into. The administrator owns nothing, so their own list is empty while their admin list is not - which is how a demo tells \"sees all rows\" apart from \"sees their own\"."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"empty - the admin holds no coverages\", function () {",
                  "    pm.expect(pm.response.json()).to.eql([]);",
                  "});"
                ]
              }
            }
          ]
        }
