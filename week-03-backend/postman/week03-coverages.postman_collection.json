    {
      "name": "7. Role-based authorization",
      "description": "Assignment 4-8 asks that the authorization levels behave differently per role, not only that a missing token is refused. The same route is sent three ways - no token, an ordinary analyst, and the administrator - so the three answers sit beside each other in one run.",
      "item": [
        {
          "name": "admin route without a token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/coverages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "coverages"
              ]
            },
            "description": "Authentication is still the first gate: require_admin is layered on require_auth rather than replacing it."
          },
