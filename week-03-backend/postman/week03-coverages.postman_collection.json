                  "pm.test(\"error body has the one shape\", function () {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b).to.have.property(\"error\");",
                  "    pm.expect(b).to.have.property(\"message\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "409 - the same filer twice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/coverages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coverages"
              ]
            },
            "description": "Analyst A already covers Apple from the seed. The conflict is detected by the unique constraint, not by a lookup before the insert - a lookup would leave a window between the two statements.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Apple again\",\n  \"cik\": \"0000320193\"\n}",
              "options": {
                "raw": {
                  "language": "json"
