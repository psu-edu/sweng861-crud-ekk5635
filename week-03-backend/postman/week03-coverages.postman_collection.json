    {
      "name": "3. CRUD as the owner",
      "description": "The five endpoints in the order a client would use them. The row created in the first request is the one deleted in the last, so the collection can be run repeatedly against the same seeded database.",
      "item": [
        {
          "name": "create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/coverages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coverages"
              ]
            },
            "description": "owner_id is not in the body and cannot be: it is taken from the token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Alphabet Inc.\",\n  \"ticker\": \"GOOGL\",\n  \"cik\": \"0001652044\",\n  \"description\": \"Created by the Postman run.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"status defaults to draft\", function () {",
                  "    pm.expect(pm.response.json().status).to.eql(\"draft\");",
                  "});",
                  "pm.test(\"owner_id is never returned\", function () {",
                  "    pm.expect(pm.response.json()).to.not.have.property(\"owner_id\");",
                  "});",
                  "// Hand the new id to the requests below rather than hardcoding one.",
                  "pm.collectionVariables.set(\"createdId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "read it back",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/coverages/{{createdId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coverages",
                "{{createdId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"is the row that was just created\", function () {",
                  "    pm.expect(pm.response.json().cik).to.eql(\"0001652044\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "list",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/coverages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coverages"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"holds the caller's rows and the new one\", function () {",
                  "    const ciks = pm.response.json().map(r => r.cik);",
                  "    pm.expect(ciks).to.include(\"0001652044\");",
                  "});",
                  "pm.test(\"no row belongs to anyone else\", function () {",
                  "    // Analyst B holds Tesla. Seeing it here would mean the list is not scoped.",
                  "    pm.expect(pm.response.json().map(r => r.cik)).to.not.include(\"0001318605\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "update",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/coverages/{{createdId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coverages",
                "{{createdId}}"
              ]
            },
            "description": "PATCH rather than PUT: cik cannot be replaced, so a full-representation verb would promise what this resource does not offer.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"the field sent changed\", function () {",
                  "    pm.expect(pm.response.json().status).to.eql(\"active\");",
                  "});",
                  "pm.test(\"a field not sent did not\", function () {",
                  "    pm.expect(pm.response.json().title).to.eql(\"Alphabet Inc.\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "delete",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/coverages/{{createdId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coverages",
                "{{createdId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "it is gone",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/coverages/{{createdId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coverages",
                "{{createdId}}"
              ]
            },
            "description": "The delete is checked by its effect, not only by its status code."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"error body has the one shape\", function () {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b).to.have.property(\"error\");",
                  "    pm.expect(b).to.have.property(\"message\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Error handling",
      "description": "Assignment 3-1 asks for error handling on every endpoint. Each case below asserts the same two-key body, because the point of the contract is that a client parses one shape rather than four.",
      "item": [
        {
          "name": "422 - cik is not ten digits",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/coverages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coverages"
              ]
            },
            "description": "320193 and 0000320193 are the same filer, but only the padded form matches the EDGAR path, so the unpadded one is refused rather than repaired.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Short CIK\",\n  \"cik\": \"320193\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422\", function () { pm.response.to.have.status(422); });",
                  "pm.test(\"error body has the one shape\", function () {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b).to.have.property(\"error\");",
                  "    pm.expect(b).to.have.property(\"message\");",
                  "});",
                  "pm.test(\"says which field was wrong\", function () {",
                  "    pm.expect(JSON.stringify(pm.response.json())).to.include(\"cik\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "422 - a caller-supplied owner_id",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/coverages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coverages"
              ]
            },
            "description": "Unknown fields are rejected, not dropped. Dropping it would answer 201 and let the caller believe they had created a row for someone else.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Not mine to give\",\n  \"cik\": \"0000789019\",\n  \"owner_id\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
