                  "    const b = pm.response.json();",
                  "    pm.expect(b).to.have.property(\"error\");",
                  "    pm.expect(b).to.have.property(\"message\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "404 - an id that exists nowhere",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
